# Neon Serverless PostgreSQL Connection String
# Obtainable from your Neon console (https://console.neon.tech) or Vercel Marketplace
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Signing Secret (minimum 32 characters recommended for production)
AUTH_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

